# ID Klien OAuth Google, dari Google Cloud Console > APIs & Services > Credentials.
# Harus NEXT_PUBLIC_* karena skrip Google Identity Services butuh nilai ini
# di browser untuk menggambar tombol "Continue with Google".
#
# Buat "OAuth client ID" bertipe "Web application", lalu tambahkan ke
# "Authorized JavaScript origins":
#   http://localhost:3000        (pengembangan)
#   https://<domain-produksimu>  (isi domain Railway aktual)
#
# Tidak perlu "Authorized redirect URIs" -- alur ini memakai token ID di
# browser (Google Identity Services), bukan redirect Authorization Code, jadi
# tidak ada rute callback dan tidak ada Client Secret yang perlu disimpan.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
